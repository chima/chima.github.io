---
import { Image } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';
import HatchBanner from '../components/HatchBanner.astro';
import Base from './Base.astro';
import { readingMinutes, type Post } from '../lib/posts';

interface Props {
	post: Post;
	/** Older post. */
	prev?: Post;
	/** Newer post. */
	next?: Post;
}

const { post, prev, next } = Astro.props;
const d = post.data;
const minutes = readingMinutes(post.body);
const eyebrow = [d.category, minutes + ' min'].filter(Boolean).join(' \u00b7 ');
---

<Base title={d.title} description={d.description} image={d.heroImage}>
	<article>
		<div class="page post-head">
			<div class="post-eyebrow">{eyebrow}</div>
			<h1 class="post-title">{d.title}</h1>
			<div class="post-date">
				<FormattedDate date={d.pubDate} />
				{
					d.updatedDate && (
						<span class="post-updated">
							{' '}&middot; updated <FormattedDate date={d.updatedDate} />
						</span>
					)
				}
			</div>
		</div>

		<div class="page page--wide hero">
			{
				d.heroImage ? (
					<Image src={d.heroImage} width={1020} height={340} alt="" />
				) : (
					<HatchBanner title={d.title} />
				)
			}
			{d.heroCaption && <div class="caption">{d.heroCaption}</div>}
		</div>

		<div class="page page-body">
			<div class="prose"><slot /></div>

			{
				d.tags.length > 0 && (
					<ul class="tag-list">
						{d.tags.map((tag) => (
							<li>
								<a class="tag" href={'/topics/' + tag + '/'}>
									{tag}
								</a>
							</li>
						))}
					</ul>
				)
			}

			{
				(prev || next) && (
					<nav class="post-nav" aria-label="More posts">
						{prev && (
							<a href={'/blog/' + prev.id + '/'}>
								<div class="post-nav__label">Previous</div>
								<div class="post-nav__title">{prev.data.title}</div>
							</a>
						)}
						{next && (
							<a class="post-nav__next" href={'/blog/' + next.id + '/'}>
								<div class="post-nav__label">Next</div>
								<div class="post-nav__title">{next.data.title}</div>
							</a>
						)}
					</nav>
				)
			}
		</div>
	</article>
</Base>
