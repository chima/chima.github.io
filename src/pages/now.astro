---
import Base from '../layouts/Base.astro';

// Update this date whenever you change the page. That is the whole point of a /now page.
const updated = 'Updated 03 Aug 2026';
---

<Base title="Now" description="What I am doing at the moment.">
	<div class="page page-head page-head--split">
		<h1 class="page-title">Now</h1>
		<span class="stamp">{updated}</span>
	</div>

	<div class="page page-body">
		<p class="lede">Two weeks at the beach in Omi&scaron;, on the Croatian coast.</p>

		<div class="now-rows">
			<div class="now-row">
				<span class="now-row__label">Working</span>
				<span class="now-row__text">Nothing, deliberately. Back to it mid-August.</span>
			</div>
			<div class="now-row">
				<span class="now-row__label">Days</span>
				<span class="now-row__text">Two kids, full time. That is the actual job this month.</span>
			</div>
			<div class="now-row">
				<span class="now-row__label">Reading</span>
				<span class="now-row__text">Nothing since TOGAF, 2025.</span>
			</div>
			<div class="now-row">
				<span class="now-row__label">Not doing</span>
				<span class="now-row__text">Anything that needs a standing meeting.</span>
			</div>
		</div>
	</div>
</Base>
