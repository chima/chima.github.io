---
import Base from '../layouts/Base.astro';

// Update this date whenever you change the page. That is the whole point of a /now page.
const updated = 'Updated 18 Aug 2026';
---

<Base title="Now" description="What I am doing at the moment.">
	<div class="page page-head page-head--split">
		<h1 class="page-title">Now</h1>
		<span class="stamp">{updated}</span>
	</div>

	<div class="page page-body">
		<p class="lede">Back in Zagreb, and back at the desk.</p>

		<div class="now-rows">
			<div class="now-row">
				<span class="now-row__label">Working</span>
				<span class="now-row__text">The day job, and the ordinary queue of tasks that comes with it.</span>
			</div>
			<div class="now-row">
				<span class="now-row__label">Days</span>
				<span class="now-row__text">Two kids. The other full-time job, and the one that does not pause.</span>
			</div>
			<div class="now-row">
				<span class="now-row__label">Reading</span>
				<span class="now-row__text">Nothing since TOGAF, 2025.</span>
			</div>
			<div class="now-row">
				<span class="now-row__label">Not doing</span>
				<span class="now-row__text">Starting anything new until the queue is shorter than it is.</span>
			</div>
		</div>
	</div>
</Base>
