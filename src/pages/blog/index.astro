---
import PostList from '../../components/PostList.astro';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<Base title="Archive" description="Everything I have written here, newest first.">
	<div class="page page-head">
		<h1 class="page-title">Archive</h1>
		<p class="page-lede">
			Everything, newest first. <a href="/topics/">By topic</a> if you&rsquo;d rather browse sideways.
		</p>
	</div>

	<div class="page page-body">
		<div class="section-head">
			<span class="section-head__label">{posts.length} posts</span>
			<span class="section-head__rule"></span>
		</div>
		<div style="margin-top:22px">
			<PostList posts={posts} variant="compact" />
		</div>
	</div>
</Base>
