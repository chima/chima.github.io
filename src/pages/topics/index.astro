---
import Base from '../../layouts/Base.astro';
import { getPosts, tagCounts } from '../../lib/posts';

const posts = await getPosts();
const tags = tagCounts(posts);
const max = tags.length > 0 ? tags[0].count : 1;

// 20px at one post, 40px at the most-used tag.
function size(count: number) {
	const t = max === 1 ? 1 : (count - 1) / (max - 1);
	return Math.round(20 + t * 20);
}
---

<Base title="Topics" description="What I write about, sized by how often.">
	<div class="page page-head">
		<h1 class="page-title">Topics</h1>
		<p class="page-lede">
			Set in the size of their count, so the shape of what you write is visible at a glance.
		</p>
	</div>

	<div class="page page-body">
		{
			tags.length > 0 ? (
				<ul class="topic-cloud">
					{tags.map((entry) => (
						<li>
							<a class="topic" href={'/topics/' + entry.tag + '/'} style={'font-size:' + size(entry.count) + 'px'}>
								{entry.tag}
								<span class="topic__count">{entry.count}</span>
							</a>
						</li>
					))}
				</ul>
			) : (
				<p class="note">
					No tags yet. Add a <code>tags</code> array to a post&rsquo;s frontmatter and it shows up here.
				</p>
			)
		}
		<p class="note">
			Each topic has its own page listing only those posts &mdash; no filtering JavaScript, all static.
		</p>
	</div>
</Base>
