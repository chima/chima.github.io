---
import PostList from '../components/PostList.astro';
import Base from '../layouts/Base.astro';
import { SITE_DESCRIPTION, SITE_INTRO, SITE_TAGLINE, SITE_TITLE } from '../consts';
import { getPosts } from '../lib/posts';

const posts = (await getPosts()).slice(0, 5);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<div class="page masthead">
		<h1 class="masthead__title">Chima&rsquo;s<br />cavern</h1>
		<div class="masthead__meta">
			<span class="masthead__tagline">{SITE_TAGLINE}</span>
			<span class="masthead__rule"></span>
		</div>
		<p class="masthead__intro">{SITE_INTRO}</p>
	</div>

	<div class="page page-body">
		<div class="section-head">
			<span class="section-head__label">Writing</span>
			<span class="section-head__rule"></span>
			<a class="section-head__link" href="/blog/">Archive &rarr;</a>
		</div>
		<PostList posts={posts} />
	</div>
</Base>
