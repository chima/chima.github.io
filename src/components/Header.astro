---
import { SITE_TITLE } from '../consts';

const raw = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/');
const path = raw.replace(/\/+$/, '') || '/';
const inWriting = path === '/blog' || path.startsWith('/blog/') || path === '/topics' || path.startsWith('/topics/');
const onAbout = path === '/about';
---

<header class="site-header">
	<div class="page site-header__inner">
		<a class="wordmark" href="/">{SITE_TITLE}</a>
		<nav class="site-nav" aria-label="Primary">
			<a href="/blog/" aria-current={inWriting ? 'page' : undefined}>Writing</a>
			<a href="/about/" aria-current={onAbout ? 'page' : undefined}>About</a>
			<a href="/rss.xml">RSS</a>
		</nav>
	</div>
</header>
